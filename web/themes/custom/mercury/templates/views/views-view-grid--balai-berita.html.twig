{% if title %}
  <h2 class="mb-6 text-3xl font-semibold">{{ title }}</h2>
{% endif %}

<div {{ attributes.addClass('grid', 'gap-6', 'md:grid-cols-2', 'lg:grid-cols-3') }}>
  {% for row in items %}
    {% for column in row.content %}
      {#
        Do not render Views' column attributes here. The grid style plugin adds
        an inline percentage width that conflicts with the Tailwind grid and
        makes every card a fraction of its grid track.
      #}
      <div class="views-row h-full">
        {{ column.content }}
      </div>
    {% endfor %}
  {% endfor %}
</div>
