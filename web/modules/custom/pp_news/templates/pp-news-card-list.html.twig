<section class="pp-news">
  <div class="pp-news-carousel">
    <button
      class="pp-news-carousel__arrow pp-news-carousel__arrow--prev"
      type="button"
      aria-label="{{ 'Previous related news'|t }}"
    >‹</button>

    <div class="pp-news-carousel__track">
      {% for item in items %}
        <div class="pp-news-carousel__item flex [&>article]:h-auto [&>article]:w-full">
          {{ include('mercury:news-card', {
            title: item.title,
            url: item.url,
            summary: item.excerpt|default(''),
            date_iso: item.date_iso|default(''),
            date_label: item.date|default(''),
            category: item.category|default(''),
            author: item.author|default(''),
            image: item.image
          }, with_context: false) }}
        </div>
      {% endfor %}
    </div>

    <button
      class="pp-news-carousel__arrow pp-news-carousel__arrow--next"
      type="button"
      aria-label="{{ 'Next related news'|t }}"
    >›</button>
  </div>
</section>
